# Релиз публикуется на GitHub (FORGE=github в release.sh) через gh CLI —
# токен не нужен, достаточно gh auth login. Репозиторий берётся из origin.

# GitLab — только для переходного зеркала latest.json (GITLAB_LATEST_MIRROR=1):
# старые клиенты ≤1.20.0 читают апдейты с gitlab.com. Убрать через пару релизов.
PROJECT_ID=84130385
API="https://gitlab.com/api/v4"
# Project access token (Settings → Access Tokens, role Maintainer, scope api)
GITLAB_TOKEN=""
# Ключ подписи updater-артефактов (см. tauri signer)
TAURI_SIGNING_PRIVATE_KEY="$HOME/.tauri/app.pem"
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# Нотаризация: Tauri сам зовёт notarytool при сборке, если заданы все три
# переменные. APPLE_PASSWORD (app-specific password) хранится в sec и
# инъектится при релизе: sec run sql-kai --only APPLE_PASSWORD -- ./release.sh
APPLE_ID="kaidstor@gmail.com"
APPLE_TEAM_ID="4SR685J3M9"
