{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sql-kai",
  "version": "1.28.0",
  "identifier": "com.kaidstor.sql-kai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "sql-kai — Postgres client",
        "width": 1280,
        "height": 820,
        "visible": false,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.github.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; connect-src 'self' ws://localhost:1420 http://localhost:1420 ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Anton Lobanov (4SR685J3M9)",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2NUE2OUQxQzcwMzFBMTQKUldRVUdnUEgwV2xhOWw2MmxOOXJpTSs2SlB1aS9QZzZQZllpSWFkM0hJWWdDRlhtNlpLRzRnNVoK",
      "endpoints": [
        "https://github.com/Kaidstor/sql-kai/releases/latest/download/latest.json",
        "https://gitlab.com/kaidstor/sql-kai/-/releases/permalink/latest/downloads/latest.json"
      ]
    }
  }
}
